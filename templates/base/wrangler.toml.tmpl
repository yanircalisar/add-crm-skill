name = "{{CRM_SLUG}}-crm"
main = "src/api/index.ts"
compatibility_date = "2024-12-01"

[assets]
directory = "./dist"
not_found_handling = "single-page-application"
binding = "ASSETS"

[vars]
CRM_NAME = "{{CRM_NAME}}"
BRAND_COLOR = "{{BRAND_COLOR}}"

[[d1_databases]]
binding = "DB"
database_name = "crm-db"
database_id = "{{D1_DATABASE_ID}}"
migrations_dir = "migrations"
