{
  "name": "crm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "add-crm migrate && wrangler d1 migrations apply DB --local && wrangler dev",
    "migrate": "add-crm migrate",
    "check": "add-crm check",
    "test": "add-crm check && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "add-crm check && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:admin": "add-crm seed-admin"
  },
  "dependencies": {
    "add-crm-core": "1.0.0"
  },
  "devDependencies": {
    "wrangler": "3.99.0"
  }
}
