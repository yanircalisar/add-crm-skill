name = "{{CRM_SLUG}}-crm"
main = "src/worker.mjs"
compatibility_date = "2024-12-01"

# The prebuilt CRM interface ships inside the add-crm-core package.
[assets]
directory = "./node_modules/add-crm-core/dist/web"
not_found_handling = "single-page-application"
binding = "ASSETS"

[vars]
CRM_NAME = "{{CRM_NAME}}"
BRAND_COLOR = "{{BRAND_COLOR}}"

[[d1_databases]]
binding = "DB"
database_name = "crm-db"
database_id = "{{D1_DATABASE_ID}}"
migrations_dir = "migrations"
